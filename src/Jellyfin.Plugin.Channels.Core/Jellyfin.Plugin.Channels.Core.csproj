<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deliberately free of any Jellyfin reference. The schedule is pure arithmetic,
    and keeping it in its own project means it cannot quietly acquire a server
    dependency, builds on any SDK, and tests in milliseconds. It also targets an
    older TFM than the plugin shell on purpose: the shell must follow whatever
    Jellyfin.Controller requires, and this should not be dragged along with it.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Bitstorm Labs</Authors>
    <Copyright>Copyright (c) 2026 Bitstorm Labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
